    ${RZV_WORKSPACE_ROOT}/rzv/fsp/src/bsp/mcu/rzv2h
    ${RZV_WORKSPACE_ROOT}/rzv/fsp/src/rm_freertos_port
    ${RZV_WORKSPACE_ROOT}/rzv/fsp/src/rm_freertos_port/cr
    ${RZV_WORKSPACE_ROOT}/rzv_cfg/fsp_cfg
    ${RZV_WORKSPACE_ROOT}/rzv_cfg/fsp_cfg/bsp
    ${RZV_WORKSPACE_ROOT}/rzv_cfg/aws
    ${RZV_WORKSPACE_ROOT}/rzv_gen
    ${RZV_WORKSPACE_ROOT}/rzv/aws/FreeRTOS/FreeRTOS/Source/include
    ${RZV_WORKSPACE_ROOT}/rzv/aws/FreeRTOS/FreeRTOS-Plus/Source/FreeRTOS-Plus-Common/include
