    ${RZV_WORKSPACE_ROOT}/src/freertos_posix/include/portable
    ${RZV_WORKSPACE_ROOT}/src/freertos_posix/include/FreeRTOS_POSIX
    ${RZV_WORKSPACE_ROOT}/src/freertos_posix/include/private
