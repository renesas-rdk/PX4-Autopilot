# rc.board_defaults.cmds — RZ/V2H S500 Drone factory param defaults

# S500 Generic: 4014
param set SYS_AUTOSTART     4014
param set SYS_AUTOCONFIG    0
param set MAV_TYPE          2
param set BAT1_N_CELLS      4
param set BAT1_CAPACITY     5300
param set CBRK_SUPPLY_CHK   894281
param set CBRK_FLIGHTTERM   0
# param set CBRK_IO_SAFETY    0
param set COM_ARM_WO_GPS    1
param set COM_OBS_AVOID     0
param set SYS_HAS_GPS       1
param set GPS_1_CONFIG      201
# GPS_SAT_INFO: To view satellites info (default 0: disable, 1: enable)
param set GPS_SAT_INFO      1
# Flight modes (RC_MAP_FLTMODE=CH5, 3-pos switch → 3 positions × 2 slots each)
# 8=Stabilized  1=Altitude(baro+TFmini)  4=Hold  7=Offboard
# Switch LOW (pos 1-2):  Stabilized  — manual attitude, no auto-hold
# Switch MID (pos 3-4):  Altitude    — baro+TFmini height hold, NO GPS required (indoor safe)
#                         ↑ Change to 4 (Hold) for outdoor GPS flight (smoother Offboard transition)
# Switch HIGH (pos 5-6): Offboard    — ROS 2 follower loop (requires heartbeat from px4_follower)
param set COM_FLTMODE1      8
param set COM_FLTMODE4      1
param set COM_FLTMODE6      7
# Allow Offboard mode without valid XY position/velocity estimate (indoor/no-GPS).
# Set to 0 for outdoor GPS flight to re-enable the safety check.
param set COM_OF_NOEST      1
param set RC1_MAX           2007
param set RC1_MIN           1015
param set RC1_TRIM          1510
param set RC2_MAX           2013
param set RC2_MIN           1012
param set RC2_TRIM          1505
param set RC3_MAX           2013
param set RC3_MIN           1025
param set RC3_TRIM          1025
param set RC4_MAX           2013
param set RC4_MIN           1012
param set RC4_TRIM          1497
param set RC5_MAX           2014
param set RC5_MIN           1012
param set RC5_TRIM          1513
param set RC6_MAX           2014
param set RC6_MIN           1012
param set RC6_TRIM          1513
param set RC7_MAX           2014
param set RC7_MIN           1012
param set RC7_TRIM          1513
param set RC8_MAX           2014
param set RC8_MIN           1012
param set RC8_TRIM          1513
param set RC_INPUT_PROTO    2
param set RC_CHAN_CNT       18
param set RC_MAP_ROLL       1
param set RC_MAP_PITCH      2
param set RC_MAP_THROTTLE   3
param set RC_MAP_YAW        4
param set RC_MAP_FLTMODE    5
param set RC_MAP_RETURN_SW  6
param set RC_MAP_ARM_SW     7
param set RC_MAP_KILL_SW    8
# Manual control input source configuration (default 3)
param set COM_RC_IN_MODE    2

# Board level/orientation
param set SENS_BOARD_ROT    4
param set SENS_BOARD_X_OFF  0.489
param set SENS_BOARD_Y_OFF  0.947

# Accelerometer offsets (m/s^2)
param set CAL_ACC0_ID       3408130
param set CAL_ACC0_PRIO     50
param set CAL_ACC0_XOFF     -0.121539
param set CAL_ACC0_YOFF     0.030705
param set CAL_ACC0_ZOFF     -0.027164
param set CAL_ACC1_ID       3408386
param set CAL_ACC1_PRIO     50
param set CAL_ACC1_XOFF     -0.056376
param set CAL_ACC1_YOFF     0.062929
param set CAL_ACC1_ZOFF     0.012903
param set CAL_ACC2_ID       3408642
param set CAL_ACC2_PRIO     50
param set CAL_ACC2_XOFF     -0.074820
param set CAL_ACC2_YOFF     0.046534
param set CAL_ACC2_ZOFF     -0.050532

# Gyroscope offsets (rad/s)
param set CAL_GYRO0_ID      3408130
param set CAL_GYRO0_PRIO    50
param set CAL_GYRO0_XOFF    0.000431
param set CAL_GYRO0_YOFF    0.002384
param set CAL_GYRO0_ZOFF    -0.000476
param set CAL_GYRO1_ID      3408386
param set CAL_GYRO1_PRIO    50
param set CAL_GYRO1_XOFF    -0.001466
param set CAL_GYRO1_YOFF    0.003652
param set CAL_GYRO1_ZOFF    -0.000023
param set CAL_GYRO2_ID      3408642
param set CAL_GYRO2_PRIO    50
param set CAL_GYRO2_XOFF    -0.000839
param set CAL_GYRO2_YOFF    0.002959
param set CAL_GYRO2_ZOFF    -0.002560

# Baro: device id present for reference; fusion is toggled by EKF2_BARO_CTRL (config.txt).
# The driver sets CAL_BARO0_ID at probe; no offset calibration needed.
# param set CAL_BARO0_ID      7239481

# Magnetometer (BMM150)
param set CAL_MAG0_ID       271362
param set CAL_MAG0_PRIO     50
param set CAL_MAG0_XODIAG   -0.013
param set CAL_MAG0_XOFF     0.471
param set CAL_MAG0_XSCALE   0.986
param set CAL_MAG0_YODIAG   0.010
param set CAL_MAG0_YOFF     -0.236
param set CAL_MAG0_YSCALE   0.950
param set CAL_MAG0_ZODIAG   0.002
param set CAL_MAG0_ZOFF     0.438
param set CAL_MAG0_ZSCALE   1.030
# Airframe configuration
# S500 X-quad: +X forward, +Y right (PX4 body frame)
# PWM_MAIN_FUNC1=101 → Motor 1 = ROTOR0, FUNC2=102 → Motor 2 = ROTOR1, etc.
# Physical motor spin (verified by user):
#   Motor 1 (ROTOR0, front-right +x+y): CCW
#   Motor 2 (ROTOR1, rear-left  -x-y):  CCW
#   Motor 3 (ROTOR2, front-left +x-y):  CW
#   Motor 4 (ROTOR3, rear-right -x+y):  CW
#
# PX4 KM sign convention (control_allocation):
#   KM = yaw_torque / thrust.  A CCW motor (viewed from above) creates a
#   CW reaction torque on the frame = NEGATIVE yaw in PX4 body frame.
#   → CCW motor: KM < 0 (negative)
#   → CW  motor: KM > 0 (positive)
# NOTE: previous sign was inverted (KM=+0.05 for CCW) → yaw authority reversed
#       → confirmed by log: tq[2]=-0.9 but drone yawed positive continuously.
param set CA_ROTOR_COUNT    4
param set CA_ROTOR0_PX      0.17
param set CA_ROTOR0_PY      0.17
param set CA_ROTOR1_PX      -0.17
param set CA_ROTOR1_PY      -0.17
param set CA_ROTOR2_PX      0.17
param set CA_ROTOR2_PY      -0.17
param set CA_ROTOR2_KM      -0.05
param set CA_ROTOR3_PX      -0.17
param set CA_ROTOR3_PY      0.17
param set CA_ROTOR3_KM      -0.05
# ===== IMU Vibration Filters =====
# S500 frame + X2216 1100KV + 1045 props
# Motor rotation at hover: ~6000-7000 RPM → ~100-117 Hz fundamental
#
# IMU_GYRO_CUTOFF: Butterworth LP filter before rate controller
#   WARNING: raising above 40 Hz caused "angular velocity non-finite" NaN error
#   during takeoff vibration (biquad IIR diverges on SPI glitch samples).
#   Keep at 40 Hz (PX4 default) until SPI reliability is confirmed (Issue #12).
param set IMU_GYRO_CUTOFF 40
# IMU_INTEG_RATE: vehicle_imu publish rate (Hz). Default 200 Hz → with gyro DRDY at ~327 Hz,
# vehicle_imu publishes every ~2 gyro samples → ~169 Hz actual. EKF2 and att_ctrl trigger on
# vehicle_imu, so they were running at ~83–166 Hz. Set to 400 Hz so vehicle_imu publishes on
# every gyro sample (~327 Hz), raising EKF2 to ~160–330 Hz and att_ctrl to ~330 Hz.
param set IMU_INTEG_RATE 400
# ===== Multi-IMU redundancy (3x ICM-45688) =====
# EKF2_MULTI_IMU=3: run one EKF2 instance PER IMU (multi-EKF) so a failed/glitching
# IMU only takes down its own filter; the EKF selector picks the healthiest estimate.
# SENS_IMU_MODE=0: with multi-EKF active, disable the central sensor voter — each EKF2
# instance binds its own dedicated IMU (required companion to EKF2_MULTI_IMU>1).
# NOTE: 3 EKF2 instances ~3x the estimator CPU; verify wq:INS0/EKF load after enabling.
param set EKF2_MULTI_IMU 3
param set SENS_IMU_MODE   0
# IMU_DGYRO_CUTOFF: D-term derivative LP filter (default 20 Hz)
#   Reduced to 20 Hz to suppress D-term sawtooth noise from SPI FIFO empty events.
param set IMU_DGYRO_CUTOFF 30
param set IMU_GYRO_DNF_EN  2
param set IMU_GYRO_FFT_EN  1

# --- Roll/Pitch Rate ---
param set MC_ROLLRATE_K  0.5900
param set MC_ROLLRATE_P  0.1430
param set MC_ROLLRATE_I  0.2250
param set MC_ROLLRATE_D  0.0040
param set MC_PITCHRATE_K 0.5600
param set MC_PITCHRATE_P 0.1390
param set MC_PITCHRATE_I 0.3500
param set MC_PITCHRATE_D 0.0036
# --- Yaw Rate ---
param set MC_YAWRATE_K   0.6000
param set MC_YAWRATE_P   0.0930
param set MC_YAWRATE_I   0.2400
param set MC_YAWRATE_D   0.0028

# --- Attitude (outer loop) ---
param set MC_ROLL_P      6.5
param set MC_PITCH_P     6.5
param set MC_YAW_P       5.0

param set THR_MDL_FAC    0.3
param set MPC_THR_HOVER  0.45
param set MPC_LAND_SPEED 0.5
param set MPC_Z_VEL_MAX_UP 1.5
param set MPC_Z_VEL_MAX_DN 1.0
param set MPC_ACC_UP_MAX 2.0
param set MPC_ACC_DOWN_MAX 2.0
param set MPC_MAN_TILT_MAX 25

param set PWM_MAIN_FUNC1    101
param set PWM_MAIN_FUNC2    102
param set PWM_MAIN_FUNC3    103
param set PWM_MAIN_FUNC4    104
param set PWM_MAIN_MIN1     1150
param set PWM_MAIN_MIN2     1150
param set PWM_MAIN_MIN3     1150
param set PWM_MAIN_MIN4     1150
param set PWM_MAIN_MAX1     1940
param set PWM_MAIN_MAX2     1940
param set PWM_MAIN_MAX3     1940
param set PWM_MAIN_MAX4     1940
param set PWM_MAIN_DIS1     800
param set PWM_MAIN_DIS2     800
param set PWM_MAIN_DIS3     800
param set PWM_MAIN_DIS4     800
param set PWM_MAIN_FAIL1    800
param set PWM_MAIN_FAIL2    800
param set PWM_MAIN_FAIL3    800
param set PWM_MAIN_FAIL4    800
param set EKF2_HGT_REF    2
param set EKF2_BARO_CTRL  0
param set EKF2_BARO_NOISE 10.0
param set EKF2_RNG_CTRL   2
param set EKF2_RNG_QLTY_T 0.5
